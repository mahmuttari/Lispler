{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      ".read": true,
      ".indexOn": ["lastSeen"],

      "$roomId": {
        ".write": "$roomId.length === 6 && $roomId.matches(/^[A-HJKMNP-Z2-9]+$/) && auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || (!newData.exists() && data.child('hostUid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['name', 'hostUid', 'status', 'maxPlayers', 'createdAt', 'lastSeen'])",

        "name":       { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "hostUid":    { ".write": "auth != null && newData.val() === auth.uid && !data.parent().child('players').child(data.val()).exists() && data.parent().child('players').child(auth.uid).exists()",
                        ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 40 && newData.val().matches(/^[A-Za-z0-9_]+$/)" },
        "hostName":   { ".write": "auth != null && newData.parent().child('hostUid').val() === auth.uid",
                        ".validate": "newData.isString() && newData.val().length <= 50" },
        "level":      { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000" },
        "status":     { ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid",
                        ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'" },
        "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 5" },
        "createdAt":  { ".validate": "newData.isNumber()" },
        "lastSeen":   { ".write": "data.exists() && auth != null && data.parent().child('players').child(auth.uid).exists()",
                        ".validate": "newData.isNumber()" },

        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "$uid.length >= 3 && $uid.length <= 40 && $uid.matches(/^[A-Za-z0-9_]+$/)",
            "name":       { ".validate": "newData.isString() && newData.val().length <= 50" },
            "charKey":    { ".validate": "newData.isString() && newData.val().length <= 30" },
            "costumeIdx": { ".validate": "newData.isNumber()" },
            "ready":      { ".validate": "newData.isBoolean()" },
            "joinedAt":   { ".validate": "newData.isNumber()" },
            "lastSeen":   { ".validate": "newData.isNumber()" },
            "x":          { ".validate": "newData.isNumber()" },
            "y":          { ".validate": "newData.isNumber()" },
            "facing":     { ".validate": "newData.isNumber()" },
            "hp":         { ".validate": "newData.isNumber()" },
            "maxHp":      { ".validate": "newData.isNumber()" },
            "walk":       { ".validate": "newData.isNumber()" },
            "invuln":     { ".validate": "newData.isBoolean()" },
            "invisible":  { ".validate": "newData.isNumber()" },
            "dead":       { ".validate": "newData.isNumber()" },
            "$other":     { ".validate": false }
          }
        },

        "state": {
          ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid",
          "g": {
            "$i": {
              "i":         { ".validate": "newData.isNumber()" },
              "x":         { ".validate": "newData.isNumber()" },
              "y":         { ".validate": "newData.isNumber()" },
              "hp":        { ".validate": "newData.isNumber()" },
              "maxHp":     { ".validate": "newData.isNumber()" },
              "size":      { ".validate": "newData.isNumber()" },
              "isBoss":    { ".validate": "newData.isNumber()" },
              "isShooter": { ".validate": "newData.isNumber()" },
              "frozen":    { ".validate": "newData.isNumber()" },
              "$other":    { ".validate": false }
            }
          },
          "p": {
            "$i": {
              "i":      { ".validate": "newData.isNumber()" },
              "x":      { ".validate": "newData.isNumber()" },
              "y":      { ".validate": "newData.isNumber()" },
              "kind":   { ".validate": "newData.isString() && newData.val().length <= 20" },
              "value":  { ".validate": "newData.isNumber()" },
              "life":   { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "e": {
            "$i": {
              "i":      { ".validate": "newData.isNumber()" },
              "x":      { ".validate": "newData.isNumber()" },
              "y":      { ".validate": "newData.isNumber()" },
              "vx":     { ".validate": "newData.isNumber()" },
              "vy":     { ".validate": "newData.isNumber()" },
              "isBoss": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "lvl":    { ".validate": "newData.isNumber()" },
          "bd":     { ".validate": "newData.isNumber()" },
          "bt":     { ".validate": "newData.isNumber()" },
          "lt":     { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "events": {
          ".write": "!newData.exists() && auth != null && data.parent().child('hostUid').val() === auth.uid",
          "$eventId": {
            ".write": "auth != null && ((!newData.exists() && data.parent().parent().child('hostUid').val() === auth.uid) || (!data.exists() && newData.child('by').val() === auth.uid && data.parent().parent().child('players').child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['type', 'by'])",
            "type":     { ".validate": "newData.isString() && newData.val().length <= 20" },
            "by":       { ".validate": "newData.isString() && newData.val().length <= 40" },
            "x":        { ".validate": "newData.isNumber()" },
            "y":        { ".validate": "newData.isNumber()" },
            "r":        { ".validate": "newData.isNumber()" },
            "dmg":      { ".validate": "newData.isNumber()" },
            "gi":       { ".validate": "newData.isNumber()" },
            "pi":       { ".validate": "newData.isNumber()" },
            "duration": { ".validate": "newData.isNumber()" },
            "$other":   { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    "accounts": {
      "$code": {
        ".read":  "$code.matches(/^[A-Z0-9][A-Z0-9][A-Z0-9]_[A-Z0-9][A-Z0-9][A-Z0-9]$/)",
        ".write": "$code.matches(/^[A-Z0-9][A-Z0-9][A-Z0-9]_[A-Z0-9][A-Z0-9][A-Z0-9]$/) && auth != null && (!data.child('ownerUid').exists() || data.child('ownerUid').val() === auth.uid) && (!newData.exists() || newData.child('ownerUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['name', 'save', 'updatedAt'])",
        "name":      { ".validate": "newData.isString() && newData.val().length <= 50" },
        "save":      { ".validate": "newData.isString() && newData.val().length <= 200000" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "ownerUid":  { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 40 && newData.val().matches(/^[A-Za-z0-9_]+$/)" },
        "$other":    { ".validate": false }
      }
    },

    "accounts_google": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['save', 'updatedAt'])",
        "name":        { ".validate": "newData.isString() && newData.val().length <= 50" },
        "googleName":  { ".validate": "newData.isString() && newData.val().length <= 200" },
        "googleEmail": { ".validate": "newData.isString() && newData.val().length <= 320" },
        "save":        { ".validate": "newData.isString() && newData.val().length <= 200000" },
        "updatedAt":   { ".validate": "newData.isNumber()" },
        "$other":      { ".validate": false }
      }
    }
  }
}
