rules_version = '2';

// Hayalet Avcıları — Cloud Firestore kuralları. Gerekçeler: README.md
service cloud.firestore {
  match /databases/{database}/documents {

    // Şampiyonlar listesi (game.js › submitOnlineScore, fetchOnlineLeaderboard, renameInLeaderboard)
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if gecerliSkor(request.resource.data) && skorSahibi(request.resource.data);
      // İsim değişikliği: yalnız kendi uid'li skorunun yalnız adı. uid'siz (3.10.2 öncesi) skorlar değişmez.
      allow update: if request.auth != null
        && resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && gecerliIsim(request.resource.data.name);
      allow delete: if false;
    }

    // Skoru yalnız girişli istemci kendi uid'iyle yazar (3.10.2+; girişsiz ve uid'siz yazım 3.10.3'te kapandı).
    function skorSahibi(d) {
      return request.auth != null && d.get('uid', '') == request.auth.uid;
    }

    function gecerliIsim(ad) {
      return ad is string && ad.size() >= 1 && ad.size() < 20;
    }

    function gecerliSkor(d) {
      return d.keys().hasOnly(['name', 'level', 'ghosts', 'para', 'score', 'date', 'uid'])
        && d.keys().hasAll(['name', 'level', 'ghosts', 'para', 'score', 'date'])
        && gecerliIsim(d.name)
        && d.level is int && d.level >= 1 && d.level <= 1000
        && d.ghosts is int && d.ghosts >= 0 && d.ghosts <= 1000000
        && d.para is int && d.para >= 0 && d.para <= 100000000
        && d.score is int && d.score == d.level * 1000 + d.ghosts * 10 + d.para
        && d.score < 10000000
        && d.date is int && d.date > 1500000000000
        && d.date <= request.time.toMillis() + 86400000;
    }

    // Oyunun kullanmadığı her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
