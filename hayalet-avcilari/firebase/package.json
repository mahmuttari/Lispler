{
  "name": "hayalet-avcilari-firebase-kurallar",
  "private": true,
  "description": "Hayalet Avcıları Firebase kurallarının emülatör testleri",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only database,firestore --project demo-hayalet-avcilari \"node --test test/kurallar.test.mjs\"",
    "test:yalniz": "node --test test/kurallar.test.mjs",
    "test:cevrimici": "firebase emulators:exec --only database,auth --project demo-hayalet-avcilari \"node ../test/cevrimici.test.mjs\"",
    "test:alti": "firebase emulators:exec --only database,auth --project demo-hayalet-avcilari \"node ../test/alti.test.mjs\"",
    "test:arkadas": "firebase emulators:exec --only database,auth --project demo-hayalet-avcilari \"node ../test/arkadas.test.mjs\"",
    "test:ek": "firebase emulators:exec --only database,auth --project demo-hayalet-avcilari \"node ../test/cevrimici-ek.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1"
  }
}
