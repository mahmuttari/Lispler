{
  "name": "kelime-bilcek-firebase-kurallar",
  "private": true,
  "description": "Kelime Bilcek Realtime Database kurallarının emülatör testleri",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only database --project demo-kelime-bilcek \"node --test test/kurallar.test.mjs\"",
    "test:yalniz": "node --test test/kurallar.test.mjs",
    "test:akis": "firebase emulators:exec --only database,auth --project demo-kelime-bilcek \"node --test ../test/akis.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1"
  }
}
