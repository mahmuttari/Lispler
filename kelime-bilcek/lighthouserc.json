{
  "ci": {
    "collect": {
      "staticDistDir": "./www",
      "url": [
        "http://localhost/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "blockedUrlPatterns": [
          "*firebasedatabase.app*",
          "*googleapis.com*",
          "*gstatic.com*",
          "*sozluk.gov.tr*",
          "*workers.dev*"
        ],
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
