{
  "name": "tavla-firebase-kurallar",
  "private": true,
  "description": "Tavla Cloud Firestore kurallarının emülatör testleri",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-tavla \"node --test test/kurallar.test.mjs\"",
    "test:akis": "firebase emulators:exec --only firestore,auth --project demo-tavla \"node --test test/akis.test.mjs\"",
    "test:sikayet": "node --test test/sikayetler.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.6.0",
    "firebase-tools": "15.32.1",
    "playwright": "1.63.0"
  }
}
