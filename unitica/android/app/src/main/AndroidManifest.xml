<?xml version="1.0" encoding="utf-8"?>
<!-- Unitica (Google Play sürümü, Poyraz Workshop). Özgün Unitica 1.3.1 (KAYNAK.txt) manifestiyle aynı ayarlar (yedekleme kapalı,
     düz HTTP kapalı, klavyede yeniden boyutlanma, tek görev); farkları: paket adı ve sürüm app/build.gradle'da, AdMob
     uygulama kimliği (gradle.properties › ADMOB_APP_ID) ve İnternet izni. Özgün sürüm hiç ağ kullanmıyordu; İnternet
     yalnız reklam (AdMob + UMP onay formu) ve Google Play aboneliği içindir, dönüştürücü çevrimdışı çalışır.
     Birleştirilen izinler: ACCESS_NETWORK_STATE ve AD_ID (play-services-ads), BILLING (Play Billing). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- AdMob uygulama kimliği: yayın derlemesinde gradle.properties › ADMOB_APP_ID, hata ayıklamada Google'ın test kimliği -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
    </application>

    <!-- Reklamlar (AdMob, UMP onay formu) ve Google Play aboneliği -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
